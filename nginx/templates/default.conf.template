# ==============================================================
# default.conf.template — Nginx config với biến môi trường
#
# Nginx Docker image tự động xử lý file này khi container start:
#   /etc/nginx/templates/*.template → envsubst → /etc/nginx/conf.d/*.conf
#
# Chỉ có ${DOMAIN} (dùng ngoặc nhọn) mới được envsubst thay thế.
# Tất cả Nginx variables ($host, $remote_addr...) dùng $ đơn bình thường
# vì envsubst của Nginx Docker chỉ thay ${VAR}, không thay $VAR.
# ==============================================================

# Docker internal DNS resolver — resolve "api" theo tên service
# lúc có request thực sự (không resolve tại startup → tránh crash)
resolver 127.0.0.11 valid=10s ipv6=off;

# ==============================================================
# Catch-all — chặn truy cập trực tiếp bằng IP (không khớp domain)
# Trả về 444: Nginx đóng kết nối ngay, không gửi response
# (443 catch-all thêm vào sau khi có SSL)
# ==============================================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    return 444;
}

# ==============================================================
# HTTP — port 80
# ==============================================================
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt ACME challenge (dùng khi xin SSL)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Proxy vào API — dùng biến $upstream để Nginx không resolve tại startup
    location / {
        proxy_pass         http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Bật dòng này và tắt location / ở trên khi đã có SSL
    # return 301 https://${DOMAIN}$request_uri;
}

